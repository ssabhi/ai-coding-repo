# Copy to .env for local development (npm run dev). Every value is optional;
# the defaults below are what the API uses when a variable is unset.
# docker compose reads the "business settings" from .env as well; see docker-compose.yml.

# --- Product data source -----------------------------------------------------
# fakestore = live https://fakestoreapi.com, fixture = bundled offline snapshot.
# Use fixture if Fake Store's Cloudflare protection blocks your network.
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=5000
# none = an outage is an error. snapshot = if Fake Store has never been reachable,
# serve the bundled snapshot (with a warning). docker-compose.yml turns this on.
FAKESTORE_FALLBACK=none
CATALOGUE_CACHE_TTL_SECONDS=300
CATALOGUE_CURRENCY=GBP

# --- Merchandising -------------------------------------------------------------
# The owner's "top rated" picks, in display order. The home page shows 5.
TOP_RATED_PRODUCT_IDS=1,5,11,17,19
# How many top rated products head each category page.
CATEGORY_TOP_RATED_LIMIT=3

# --- Email ---------------------------------------------------------------------
# console = log emails instead of sending (no setup needed)
# smtp    = send via SMTP; `docker compose up mailpit` gives you a local inbox
#           at http://localhost:8025 on localhost:1025
EMAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO_EMAIL=sales@example.com
ENQUIRY_FROM_EMAIL=catalogue@example.com
ENQUIRY_RATE_LIMIT_PER_15_MIN=10

# --- Server --------------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
# Base URL of the web app, used for product links in enquiry emails.
PUBLIC_WEB_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, 1 behind nginx).
TRUST_PROXY_HOPS=0
